[Unit]
# Project: Fleet-Filter (Bundle Y) - keeps the fleet console's cache fresh without a human in the loop.
# Companion to fleet-filter-ui.service: that unit serves the console, this one refills the SQLite cache
# the console reads. Nothing served depends on it. A failed sync leaves the console rendering the last
# good cache (the stale-on-error rule in the repository documentation), which is why freshness belongs to this
# timer and not to the app process.
Description=fleet-filter-ui: refresh the fleet console cache (Bundle Y)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Same account as the console itself, for the same reason: web/sync.py authenticates to every
# registered host with the agent user's SSH key, and /var/lib/fleet-filter-ui is owned by that user.
User=agent
Group=agent
WorkingDirectory=/home/agent/projects/Fleet-Filter
# The two paths the console unit also sets, so a manual `systemctl start` of either unit reads the
# same registry and writes the same cache rather than silently creating a second one.
Environment=PT_UI_DB=/var/lib/fleet-filter-ui/cache.db
Environment=PT_UI_REGISTRY=/home/agent/projects/Fleet-Filter/web/installs.yaml
ExecStart=/home/agent/projects/Fleet-Filter/.venv/bin/python web/sync.py
# Twelve registered hosts, two of which answer today; sync.py caps each ssh at ConnectTimeout=8 with a
# 25 s per-host ceiling, so a full sweep is bounded near two minutes. The timeout sits above that
# ceiling rather than at it, so a genuinely hung sweep is killed and retried on the next tick instead
# of stacking processes on top of the console.
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/fleet-filter-ui
# A sweep is a burst of short SSH sessions; nice it below the console so refreshing the cache never
# competes with an operator's own request for CPU.
Nice=10
