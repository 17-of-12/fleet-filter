# Every 15 minutes. Policies are cheap to render and validating is the gateway's own parser, so a
# short interval keeps a signature change close to its deployment without a push channel.
[Unit]
Description=Timer for per-host policy publishing

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true
Unit=fleet-filter-policy-publish.service

[Install]
WantedBy=timers.target
