#!/usr/bin/env python3
"""
fail2ban -> Fleet-Filter bridge (installed as /usr/local/bin/f2b-fleet-filter).

fail2ban invokes an action as:

    <script> <jail-name> <offending-ip> [failure-count]

Everything fail2ban knows about a detection is those positional arguments, so this
shim's only job is to turn them into the same Wazuh-shaped alert JSON that
detector/wazuh/active-response/fleet-filter.sh receives, and hand it to

    adaptive-tarpit ingest --render --source fail2ban-<jail-name>

Rationale: the controller's `ingest` is the single place verdicts enter the store, so
every detection source stays a thin translator and the sources cannot drift apart.
Swapping fail2ban for Wazuh later means disabling a jail, not changing the controller.

Two deliberate choices:

  * `actionunban` in the matching action file is a no-op. fail2ban owns its own ban
    timer; if it also revoked our lease we would have two clocks expiring the same
    address. The controller's own expiry (adaptive-tarpit.timer) stays the only reaper.
  * the verdict defaults to `suspect`, matching the policy that behavioural detections
    earn a short lease while only exploit-signature matches are `confirmed`. Override
    with --verdict for a jail whose detections are certain.

Python 3.6+ (lab-web01's /usr/bin/python3 is 3.6.8).
"""

import json
import os
import sys
import time

USAGE = "usage: f2b-fleet-filter [--at-bin PATH] [--db PATH] [--map PATH] [--allowlist PATH] "\
        "[--verdict V] [--ttl SECS] [--location LOG] [--agent-id ID] [--agent-name NAME] "\
        "[--no-render] [--dry-run] <jail> <ip> [failure-count]"


def parse_args(argv):
    opts = {
        # Every location defaults to the controller's own default, or to the environment
        # override the Wazuh shim also honours, so a test or a non-standard install does
        # not need the file edited.
        "at_bin": os.environ.get("ADAPTIVE_TARPIT_BIN", "/usr/local/bin/adaptive-tarpit"),
        "db": os.environ.get("ADAPTIVE_TARPIT_DB", ""),
        "map": os.environ.get("ADAPTIVE_TARPIT_MAP", ""),
        "allowlist": os.environ.get("ADAPTIVE_TARPIT_ALLOWLIST", ""),
        "verdict": "suspect",
        "ttl": None,
        "location": "/var/log/httpd/access_log",
        "agent_id": "",
        "agent_name": "",
        "render": True,
        "dry_run": False,
    }
    positional = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("--at-bin", "--db", "--map", "--allowlist",
                   "--verdict", "--ttl", "--location", "--agent-name", "--agent-id"):
            if i + 1 >= len(argv):
                die("%s requires a value\n%s" % (arg, USAGE))
            key = arg[2:].replace("-", "_")
            opts[key] = argv[i + 1]
            i += 2
            continue
        if arg == "--no-render":
            opts["render"] = False
        elif arg == "--dry-run":
            opts["dry_run"] = True
        elif arg in ("--help", "-h"):
            sys.stdout.write(USAGE + "\n")
            sys.exit(0)
        elif arg.startswith("-"):
            die("unknown option %s\n%s" % (arg, USAGE))
        else:
            positional.append(arg)
        i += 1
    if len(positional) < 2:
        die("need <jail> and <ip>\n%s" % USAGE)
    if opts["verdict"] not in ("suspect", "confirmed"):
        die("verdict must be suspect or confirmed, got %r" % opts["verdict"])
    return opts, positional


def die(message):
    sys.stderr.write("f2b-fleet-filter: %s\n" % message)
    sys.exit(1)


def build_alert(opts, jail, ip, failures):
    """Shape a fail2ban detection like the Wazuh alert payload ingest already accepts."""
    alert = {
        # No `agent` block unless configured: fail2ban is host-local, and ingest only
        # cross-checks the agent id when one is present.
        "manager": {"name": "fail2ban-local"},
        "id": "f2b-%d-%s" % (int(time.time()), jail),
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000+0000", time.gmtime()),
        "location": opts["location"],
        "rule": {
            # No Wazuh rule id exists for a fail2ban detection; ingest derives the
            # provenance from --source instead (see the --source argument below).
            "id": "",
            "fid": "",
            "level": 3 if opts["verdict"] == "suspect" else 12,
            "description": "fail2ban jail %s (%s failures)" % (jail, failures),
            "groups": ["fail2ban", "fleet-filter"],
        },
        "full_log": "%s - - [fail2ban] jail %s banned the address" % (ip, jail),
        "data": {"srcip": ip, "jail": jail},
    }
    if opts["agent_id"] or opts["agent_name"]:
        alert["agent"] = {"id": opts["agent_id"], "name": opts["agent_name"]}
    return alert


def main(argv):
    opts, positional = parse_args(argv)
    jail = positional[0]
    ip = positional[1]
    failures = positional[2] if len(positional) > 2 else "1"

    # Global options must precede the subcommand; argparse rejects them after `ingest`.
    argv_out = [opts["at_bin"]]
    for flag, key in (("--db", "db"), ("--map", "map"), ("--allowlist", "allowlist")):
        if opts[key]:
            argv_out += [flag, opts[key]]
    argv_out += ["ingest", "--source", "fail2ban-%s" % jail, "--verdict", opts["verdict"]]
    if opts["ttl"]:
        argv_out += ["--ttl", str(opts["ttl"])]
    if opts["render"]:
        argv_out += ["--render"]
    if opts["dry_run"]:
        argv_out += ["--dry-run"]

    payload = json.dumps(build_alert(opts, jail, ip, failures))
    try:
        handle = subprocess_popen(argv_out)
    except OSError as exc:
        die("cannot run %s: %s" % (opts["at_bin"], exc))
    stdout, stderr = handle.communicate(payload.encode("utf-8"))
    for line in (stdout or b"").decode("utf-8", "replace").splitlines():
        sys.stdout.write("%s\n" % line)
    for line in (stderr or b"").decode("utf-8", "replace").splitlines():
        sys.stderr.write("%s\n" % line)
    return handle.returncode


def subprocess_popen(argv):
    import subprocess
    return subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
