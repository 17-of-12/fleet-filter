[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = https://git.example.internal/platform/campus-portal.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "release/2026.11"]
	remote = origin
	merge = refs/heads/release/2026.11
[user]
	name = Campus Portal Service Account
	email = portal-svc@example.internal
[http]
	sslVerify = true
[gc]
	auto = 6700
[fetch]
	prune = false
[pull]
	ff = only
